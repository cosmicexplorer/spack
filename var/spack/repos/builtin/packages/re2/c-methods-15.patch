 }
 
-}  // namespace re2
+TEST(RE2, StringWrapper) {
+  // We can use StringWrapper to wrap std::string.
+
+  StringWrapper s;
+
+  ASSERT_EQ(s.view(), "");
+  ASSERT_TRUE(s.empty());
+
+  s = absl::string_view("asdf");
+  ASSERT_EQ(s.view(), "asdf");
+  ASSERT_FALSE(s.empty());
+
+  s = std::string("bbbb");
+  ASSERT_EQ(s.view(), "bbbb");
+  ASSERT_FALSE(s.empty());
+}
+
+TEST(RE2, GroupNames) {
+  // We can generate group names.
+
+  RE2 no_groups("asdf");
+  RE2 num_group("(a)sdf");
+  RE2 named_group("(?P<foo>a)sdf");
+  RE2 mixed_groups("(?P<foo>a)s(d)f");
+
+  ASSERT_TRUE(RE2::FullMatch("asdf", no_groups));
+  GroupNames g1(no_groups.NamedCapturingGroups());
+  ASSERT_EQ(0, g1.len());
+
+  std::string s;
+
+  ASSERT_TRUE(RE2::FullMatch("asdf", num_group, &s));
+  ASSERT_EQ("a", s);
+  s.clear();
+  GroupNames g2(num_group.NamedCapturingGroups());
+  ASSERT_EQ(0, g2.len());
+
+  ASSERT_TRUE(RE2::FullMatch("asdf", named_group, &s));
+  ASSERT_EQ("a", s);
+  s.clear();
+
+  const auto &m3 = named_group.NamedCapturingGroups();
+  ASSERT_EQ(1, m3.size());
+  ASSERT_EQ(1, m3.at("foo"));
+
+  GroupNames g3(named_group.NamedCapturingGroups());
+  ASSERT_EQ(2, g3.len());
+  ASSERT_EQ("foo", g3.get_name(1));
+
+  const auto &m4 = mixed_groups.NamedCapturingGroups();
+  ASSERT_EQ(1, m4.size());
+  ASSERT_EQ(1, m4.at("foo"));
+
+  GroupNames g4(named_group.NamedCapturingGroups());
+  ASSERT_EQ(2, g4.len());
+  ASSERT_EQ("foo", g4.get_name(1));
+}
+
+} // namespace re2
