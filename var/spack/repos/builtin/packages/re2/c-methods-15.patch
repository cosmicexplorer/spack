+StringWrapper::StringWrapper() : inner_() {}
+StringWrapper::StringWrapper(absl::string_view s) : inner_(s) {}
+StringWrapper::StringWrapper(std::string &&s) : inner_(s) {}
+
+StringWrapper &StringWrapper::operator=(absl::string_view s) {
+  inner_ = std::string(s);
+  return *this;
+}
+StringWrapper &StringWrapper::operator=(std::string &&s) {
+  inner_ = s;
+  return *this;
+}
+
+StringWrapper::~StringWrapper() {}
+
+bool StringWrapper::empty() const { return inner_.empty(); }
+
+absl::string_view StringWrapper::view() const { return inner_; }
+
+std::string *StringWrapper::get_mutable() { return &inner_; }
+
+GroupNames::GroupNames(const std::map<std::string, int> &m) : names_() {
+  for (const auto &n : m) {
+    assert(n.second > 0);
+    const size_t n2 = n.second;
+    if (n2 + 1 > names_.size()) {
+      names_.resize(n2 + 1);
+    }
+    names_[n2] = n.first;
+  }
+}
+GroupNames::~GroupNames() {}
+
+size_t GroupNames::len() const { return names_.size(); }
+absl::string_view GroupNames::get_name(size_t i) const {
+  return names_.at(i).view();
+}
 
