+StringWrapper::StringWrapper(std::string &&s) : inner_(s) {}
+
+StringWrapper &StringWrapper::operator=(absl::string_view s) {
+  inner_ = std::string(s);
+  return *this;
+}
+StringWrapper &StringWrapper::operator=(std::string &&s) {
+  inner_ = s;
+  return *this;
+}
+
+StringWrapper::~StringWrapper() {
+  std::cerr << "destroyed string wrapper with len=" << size() << std::endl;
+}
+
+bool StringWrapper::empty() const { return inner_.empty(); }
+
+size_t StringWrapper::size() const { return inner_.size(); }
+
+absl::string_view StringWrapper::view() const { return inner_; }
+
+std::string* StringWrapper::get_mutable() { return &inner_; }
+
+GroupNames::GroupNames(const RE2 &r) : names_() {
+  for (const auto &n : r.NamedCapturingGroups()) {
+    assert(n.second > 0);
+    const size_t n2 = n.second;
+    names_.emplace_back(n.first, n2);
+  }
+}
+GroupNames::~GroupNames() {
+  std::cerr << "destroyed group names with len=" << size() << std::endl;
+}
+
+size_t GroupNames::size() const { return names_.size(); }
+
+const NamedGroup& GroupNames::at(size_t i) const {
+  return names_.at(i);
+}
 
